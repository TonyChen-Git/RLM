{
  "schemaVersion": 2,
  "profiles": {
    "2h": {
      "durationSeconds": 7200,
      "minimumCompletedCycles": 2
    },
    "8h": {
      "durationSeconds": 28800,
      "minimumCompletedCycles": 8
    },
    "24h": {
      "durationSeconds": 86400,
      "minimumCompletedCycles": 24
    },
    "multi-day": {
      "durationSeconds": 259200,
      "minimumCompletedCycles": 72
    }
  },
  "shards": [
    {
      "category": "agent",
      "filter": "(?m)^(?:[A-Za-z_][A-Za-z0-9_]*\\.)?(?:AgentCoreTests|AgentRuntimeApprovalSerializationTests|AgentRuntimeAutoTestTests|AgentRuntimeCompletionInvariantTests|AgentRuntimeGitLifecycleTests|AgentRuntimeLimitTests|AgentRuntimeReviewWorkflowTests|AgentRuntimeStreamingTests|AgentProviderStreamingTests|AgentProviderToolCallingTests|AgentLocalMemoryStoreTests|AgentLocalMemoryIntegrationTests|AgentProjectSettingsTests|AgentProjectSettingsIntegrationTests|AgentProjectImportRollbackTests|ProjectInstructionImporterTests|ProjectInstructionRuleProjectorTests|ExternalAssistantChatImporterTests|ExternalAssistantChatImportIntegrationTests)/test[A-Za-z0-9_]+$"
    },
    {
      "category": "pty",
      "filter": "(?m)^(?:[A-Za-z_][A-Za-z0-9_]*\\.)?(?:PseudoTerminalSessionTests|TaskTerminalServiceTests|AgentTerminalStreamingTests|SSHInteractiveTerminalTests|AgentViewModelTaskTerminalLifecycleTests|AgentWorkerAuthorityTests|RemoteRunnerTests)/test[A-Za-z0-9_]+$"
    },
    {
      "category": "subagent",
      "filter": "(?m)^(?:[A-Za-z_][A-Za-z0-9_]*\\.)?(?:SubagentSchedulerTests)/test[A-Za-z0-9_]+$"
    },
    {
      "category": "automation",
      "filter": "(?m)^(?:[A-Za-z_][A-Za-z0-9_]*\\.)?(?:AutomationSchedulerTests|GitHubWebhookIngressTests|PullRequestProviderTests)/test[A-Za-z0-9_]+$"
    },
    {
      "category": "browser",
      "filter": "(?m)^(?:[A-Za-z_][A-Za-z0-9_]*\\.)?(?:BrowserToolTests|BrowserAnnotationTests|CDPWebSocketLifecycleTests)/test[A-Za-z0-9_]+$"
    },
    {
      "category": "ollama-reconnect",
      "filter": "(?m)^(?:[A-Za-z_][A-Za-z0-9_]*\\.)?(?:AgentProviderStreamingTests|LLMReasoningStreamTests|MCPRuntimeTests|MCPConnectionLifecycleTests|MCPProtocolConfigurationTests|MCPHTTPHeaderProjectionTests|MCPStatelessClientTests|MCPStatelessHTTPTests|MCPStdioNegotiationTests|MCPManagerAuthorityTests|MCPViewModelPersistenceTests|MCPStreamableHTTPTests|MCPResourcesPromptsTests|PhaseDOAuthAndMCPTests|PluginRegistryIntegrityTests|PhaseDPluginAndHookTests)/test[A-Za-z0-9_]+$"
    },
    {
      "category": "task-switching",
      "filter": "(?m)^(?:[A-Za-z_][A-Za-z0-9_]*\\.)?(?:AgentViewModelConcurrencyTests|ChatViewModelConcurrencyTests|AgentViewModelPersistenceTests|AgentSessionStoreOrderingTests|AgentQueuedFollowUpTests|AgentSteerTests|AgentSteerReceiptStoreTests|SideChatSessionTests|TaskVoiceProviderTests)/test[A-Za-z0-9_]+$"
    },
    {
      "category": "failure-injection",
      "filterSource": "requiredFailureScenarios"
    }
  ],
  "requiredFailureScenarios": {
    "force-quit": "AgentCoreTests/testInterruptedRunRecoveryPersistsTruthfulPausedState",
    "disk-full": "PhaseHUpdateTests/testDiskFullAfterAtomicSwapRestoresPreviousApplication",
    "network-down": "PhaseHFailureInjectionTests/testNetworkDownLeavesUpdateStateUnchanged",
    "ollama-down": "PhaseHFailureInjectionTests/testOllamaDownSurfacesConnectionFailureWithoutModels",
    "mcp-crash": "PhaseHFailureInjectionTests/testMCPProcessCrashFailsPendingRequestAndDisconnects",
    "browser-crash": "PhaseHFailureInjectionTests/testBrowserCrashCleansEphemeralProfileAndSession",
    "pty-crash": "PseudoTerminalSessionTests/testPTYSignalCrashReportsTerminationAndCompletes",
    "git-lock": "PhaseHFailureInjectionTests/testGitIndexLockFailsWithoutMutatingIndexOrWorktree",
    "worktree-deleted": "ManagedWorktreeServiceLifecycleTests/testRepairMarksExternallyDeletedCheckoutMissingWithoutReleasingLease",
    "remote-disconnect": "PhaseHFailureInjectionTests/testRemoteDisconnectPropagatesStableConnectionFailure"
  }
}
