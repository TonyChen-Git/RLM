<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- LumaChat asks for Automation consent only when the user explicitly
         connects a supported app. get-task-allow and broad code-signing
         exceptions are intentionally absent. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
